# Neon dashboard에서 복사하는 PostgreSQL 연결 주소
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# 32자 이상의 임의 문자열. 실제 값은 GitHub에 올리지 않습니다.
AUTH_SECRET=replace-with-a-long-random-secret

# Windows 로컬 PaddleOCR 가상환경을 다른 위치에 설치한 경우에만 지정합니다.
# PADDLE_PYTHON=C:\path\to\python.exe

NODE_ENV=production
